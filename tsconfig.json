{
  "compilerOptions": {
    // 현대 Node.js에서 지원하는 ES2022 문법으로 출력해 async/await 등의 불필요한 변환을 줄입니다.
    // 구형 Node.js도 지원해야 한다면 해당 런타임이 지원하는 target으로 낮춰야 합니다.
    "target": "ES2022",

    // Node.js의 모듈 해석 규칙을 따릅니다. 현재 package.json에 type이 없으므로 CommonJS로 출력합니다.
    // moduleResolution과 esModuleInterop은 NodeNext에서 자동 설정되므로 중복 지정하지 않습니다.
    "module": "NodeNext",

    // 브라우저 DOM 타입 없이 ES2022 표준 API만 포함합니다.
    "lib": ["ES2022"],

    // crypto, process, URLSearchParams 등 Node.js API의 타입을 명시적으로 불러옵니다.
    "types": ["node"],

    // 암시적 any, null/undefined 처리 등 엄격한 타입 검사를 활성화합니다.
    "strict": true,

    // 외부 선언 파일의 내부 검사는 생략해 검사 시간을 줄입니다. 프로젝트 소스 검사는 유지합니다.
    "skipLibCheck": true,

    // 타입 오류가 있으면 JavaScript를 생성하지 않아 잘못된 빌드 결과가 배포되는 것을 방지합니다.
    "noEmitOnError": true,

    // 운영체제마다 다른 파일명 대소문자 처리로 생기는 import 오류를 방지합니다.
    "forceConsistentCasingInFileNames": true
  },

  // 라이브러리와 기존 테스트만 컴파일합니다. node_modules 등은 기본 제외 규칙을 따릅니다.
  // 출력 경로를 지정하지 않아 index.js와 src/*.js가 소스 옆에 생성되는 기존 배포 구조를 유지합니다.
  "include": ["index.ts", "src/**/*.ts", "test.ts"]
}
